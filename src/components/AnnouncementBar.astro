---
// src/components/AnnouncementBar.astro
---

<div class="bg-[#0F172A] text-white text-[11px] sm:text-xs py-2 px-4 border-b border-[#B8860B]/30 tracking-wide font-medium">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="hidden sm:flex items-center gap-2 text-[#C5A059]">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span>Edición Limitada 2026</span>
    </div>

    <div class="flex items-center justify-center gap-2 w-full sm:w-auto text-center">
      <span class="text-white font-semibold">ENVÍO GRATIS A DOMICILIO</span>
      <span class="text-[#C5A059] font-bold">•</span>
      <span class="text-[#C5A059] font-bold uppercase">PAGA AL RECIBIR EN TU PUERTA</span>
    </div>

    <div class="hidden sm:flex items-center gap-1.5 text-slate-300">
      <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
      <span>Stock Disponible</span>
    </div>
  </div>
</div>
