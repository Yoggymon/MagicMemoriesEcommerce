---
// src/components/ProductHero.astro
const galleryImages = [
  {
    id: "img-1",
    src: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1920&q=85",
    alt: "Maletín con espejo LED encendido y cosméticos organizados",
    tag: "Espejo LED Inteligente de 3 Tonos con Pantalla Táctil HD"
  },
  {
    id: "img-2",
    src: "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=1920&q=85",
    alt: "Compartimentos modulares ajustables y organizador de brochas",
    tag: "Compartimentos de EVA Acolchados y Modulares"
  },
  {
    id: "img-3",
    src: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=1920&q=85",
    alt: "Acabado exterior de lujo en cuero vegano con herrajes dorados reforzados",
    tag: "Cuero Vegano Texturizado con Herrajes Dorados"
  },
  {
    id: "img-4",
    src: "https://images.unsplash.com/photo-1583241800698-e8ab01830a07?auto=format&fit=crop&w=1920&q=85",
    alt: "Luz táctil regulable en 3 temperaturas de color",
    tag: "3 Temperaturas de Luz: Fría, Cálida y Natural"
  },
  {
    id: "img-5",
    src: "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=1920&q=85",
    alt: "Maletín transportable con correa ergonómica para viajes",
    tag: "Diseño Liviano y Cómodo para Viajes y Sesiones"
  }
];
---

<section id="producto" class="border-b border-[#E5E7EB] bg-white">
  
  <!-- 1. Carrusel de Extremo a Extremo (Full-Width Edge-to-Edge) -->
  <div class="w-full relative overflow-hidden bg-[#FBF7EE]/40 border-b border-[#E8D7A8]/50">
    <div class="w-full relative aspect-[16/9] sm:aspect-[21/9] md:aspect-[2.4/1] max-h-[560px] min-h-[340px] flex items-center justify-center">
      
      <!-- Top badges over carousel -->
      <div class="absolute top-4 sm:top-6 left-4 sm:left-8 z-20 flex flex-wrap gap-2">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#0F172A] text-white tracking-wider border border-[#B8860B]/40 shadow-xs">
          EDICIÓN EXCLUSIVA 2026
        </span>
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#B8860B] text-white tracking-wide shadow-xs">
          28% DE DESCUENTO HOY
        </span>
      </div>

      <!-- Main Full-Bleed Image Display -->
      <img
        id="main-carousel-img"
        src={galleryImages[0].src}
        alt={galleryImages[0].alt}
        class="w-full h-full object-cover object-center transition-opacity duration-300"
      />

      <!-- Navigation Overlay Arrows -->
      <button
        id="carousel-prev"
        type="button"
        class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/90 hover:bg-white text-[#0F172A] shadow-lg flex items-center justify-center border border-[#E5E7EB] transition-all hover:scale-105 active:scale-95 z-20 cursor-pointer"
        aria-label="Foto anterior"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="carousel-next"
        type="button"
        class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/90 hover:bg-white text-[#0F172A] shadow-lg flex items-center justify-center border border-[#E5E7EB] transition-all hover:scale-105 active:scale-95 z-20 cursor-pointer"
        aria-label="Foto siguiente"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Bottom Caption Bar on Carousel -->
      <div class="absolute bottom-3 sm:bottom-4 left-4 sm:left-8 right-4 sm:right-8 z-20 flex items-center justify-between pointer-events-none">
        <span id="carousel-caption" class="bg-white/95 backdrop-blur-xs py-1.5 px-3.5 rounded-lg text-xs sm:text-sm font-medium text-[#0F172A] border border-[#E5E7EB] shadow-xs">
          {galleryImages[0].tag}
        </span>
        <span id="carousel-counter" class="bg-[#0F172A]/80 text-white font-mono text-xs py-1.5 px-3 rounded-lg">
          1 / 5
        </span>
      </div>

    </div>

    <!-- Thumbnails Strip Under Carousel -->
    <div class="max-w-4xl mx-auto px-4 py-3 sm:py-4">
      <div class="grid grid-cols-5 gap-2 sm:gap-3">
        {galleryImages.map((img, idx) => (
          <button
            type="button"
            data-index={idx}
            data-src={img.src}
            data-alt={img.alt}
            data-tag={img.tag}
            class={`carousel-thumb relative rounded-xl overflow-hidden border-2 aspect-[16/10] sm:aspect-[16/9] transition-all cursor-pointer ${
              idx === 0
                ? 'border-[#B8860B] ring-2 ring-[#B8860B]/20 shadow-xs opacity-100'
                : 'border-[#E5E7EB] opacity-60 hover:opacity-100'
            }`}
          >
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover" />
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- 2. Información del Producto & Compra Proporcional -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Value Details -->
      <div class="lg:col-span-7">
        
        <div class="flex items-center gap-2 mb-2.5">
          <div class="flex items-center text-[#B8860B] text-sm">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <span class="text-xs font-bold text-[#0F172A]">4.9 de 5</span>
          <span class="text-xs text-[#64748B]">•</span>
          <a href="#testimonios" class="text-xs font-semibold text-[#B8860B] hover:underline">
            +840 clientas satisfechas
          </a>
        </div>

        <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#0F172A] leading-tight mb-2">
          Maletín con Maquillaje Premium & Espejo LED
        </h1>

        <p class="text-xs sm:text-sm font-semibold text-[#B8860B] tracking-wide uppercase mb-4">
          Organizador Profesional de Cosméticos con Iluminación Táctil
        </p>

        <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-6">
          El maletín todo en uno que necesitás para tener tus cosméticos ordenados, protegidos y con luz profesional donde vayas. Espejo táctil con 3 tonos de iluminación, compartimentos de tamaño regulable y batería recargable por USB-C.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-[#334155] mb-6">
          <div class="flex items-center gap-2">
            <span class="text-[#059669] font-bold">✓</span>
            <span>Espejo táctil con brillo graduable</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#059669] font-bold">✓</span>
            <span>Batería de larga duración USB-C</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#059669] font-bold">✓</span>
            <span>Separadores acolchados desmontables</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#059669] font-bold">✓</span>
            <span>Acabado en cuero impermeable</span>
          </div>
        </div>

      </div>

      <!-- Right: Direct Purchase Card -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-[#FAFAFA] border border-[#E5E7EB] p-5 sm:p-7 shadow-xs">
          
          <div class="flex items-baseline justify-between mb-4 pb-4 border-b border-[#E5E7EB]">
            <div>
              <div class="flex items-baseline gap-2.5">
                <span class="font-serif text-3xl sm:text-4xl font-extrabold text-[#0F172A]">
                  S/. 129.00
                </span>
                <span class="text-sm line-through text-[#94A3B8] font-medium">
                  S/. 179.00
                </span>
              </div>
              <span class="text-[11px] font-bold text-[#059669]">Ahorras S/. 50.00 con envío gratis</span>
            </div>
            <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-[#B8860B] text-white">
              28% OFF
            </span>
          </div>

          <!-- Quick Actions hooked to CartModal -->
          <div class="space-y-3 mb-5">
            <button
              id="hero-buy-now-btn"
              type="button"
              class="w-full py-3.5 px-5 rounded-xl font-bold text-sm sm:text-base text-white bg-[#0F172A] hover:bg-[#1E293B] border border-[#B8860B] transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>COMPRAR AHORA — PAGO AL RECIBIR</span>
              <span class="text-[#C5A059]">→</span>
            </button>

            <button
              id="hero-add-cart-btn"
              type="button"
              class="w-full py-3 px-5 rounded-xl font-bold text-xs sm:text-sm text-[#0F172A] bg-white hover:bg-[#F8FAFC] border border-[#CBD5E1] transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4 text-[#B8860B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Agregar a la Bolsa</span>
            </button>
          </div>

          <!-- Trust points -->
          <div class="space-y-1.5 text-[11px] text-[#475569] pt-4 border-t border-[#E5E7EB]">
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span><strong>Pagas en efectivo o transferencia</strong> al recibir en mano.</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span>Envío gratis a todo el país en 24 a 48 horas.</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span>Garantía de satisfacción y cambio por 30 días.</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function setupProductCarousel() {
    const mainImg = document.getElementById('main-carousel-img') as HTMLImageElement;
    const caption = document.getElementById('carousel-caption');
    const counter = document.getElementById('carousel-counter');
    const thumbs = document.querySelectorAll('.carousel-thumb');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    if (!mainImg || thumbs.length === 0) return;

    let currentIndex = 0;

    function updateCarousel(index: number) {
      currentIndex = (index + thumbs.length) % thumbs.length;
      const targetThumb = thumbs[currentIndex];
      const src = targetThumb.getAttribute('data-src') || '';
      const alt = targetThumb.getAttribute('data-alt') || '';
      const tag = targetThumb.getAttribute('data-tag') || '';

      mainImg.src = src;
      mainImg.alt = alt;
      if (caption) caption.textContent = tag;
      if (counter) counter.textContent = `${currentIndex + 1} / ${thumbs.length}`;

      thumbs.forEach((t, i) => {
        if (i === currentIndex) {
          t.classList.remove('border-[#E5E7EB]', 'opacity-60');
          t.classList.add('border-[#B8860B]', 'ring-2', 'ring-[#B8860B]/20', 'opacity-100');
        } else {
          t.classList.remove('border-[#B8860B]', 'ring-2', 'ring-[#B8860B]/20', 'opacity-100');
          t.classList.add('border-[#E5E7EB]', 'opacity-60');
        }
      });
    }

    thumbs.forEach((t) => {
      t.addEventListener('click', () => {
        const idx = parseInt(t.getAttribute('data-index') || '0', 10);
        updateCarousel(idx);
      });
    });

    prevBtn?.addEventListener('click', () => updateCarousel(currentIndex - 1));
    nextBtn?.addEventListener('click', () => updateCarousel(currentIndex + 1));

    // Hook up Buy Now and Add to Cart to CartModal
    const buyNowBtn = document.getElementById('hero-buy-now-btn');
    const addCartBtn = document.getElementById('hero-add-cart-btn');

    const heroItem = {
      id: "prod-1",
      name: "Maletín con Maquillaje Premium & Espejo LED",
      price: 129,
      qty: 1,
      image: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80"
    };

    buyNowBtn?.addEventListener('click', () => {
      if ((window as any).openCartWithItem) {
        (window as any).openCartWithItem(heroItem);
      }
    });

    addCartBtn?.addEventListener('click', () => {
      if ((window as any).openCartWithItem) {
        (window as any).openCartWithItem(heroItem);
      }
    });
  }

  setupProductCarousel();
  document.addEventListener('astro:page-load', setupProductCarousel);
</script>
