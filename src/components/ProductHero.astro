---
// src/components/ProductHero.astro
import { getProducts } from '../lib/sanity';

const products = await getProducts();
const initialProduct = products[0];
---

<section id="producto" class="border-b border-[#E5E7EB] bg-white">
  
  <!-- 1. Carrusel de Extremo a Extremo (Full-Width Edge-to-Edge) -->
  <div id="carousel-stage" class="w-full relative overflow-hidden bg-[#FBF7EE]/40 border-b border-[#E8D7A8]/50">
    <div class="w-full relative aspect-[4/3] xs:aspect-[16/10] sm:aspect-[16/9] md:aspect-[2.2/1] min-h-[250px] sm:min-h-[360px] max-h-[560px] flex items-center justify-center">
      
      <!-- Top badges over carousel -->
      <div class="absolute top-3 sm:top-6 left-3 sm:left-8 z-20 flex flex-wrap gap-1.5 sm:gap-2">
        <span
          id="carousel-badge"
          class={`px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-bold tracking-wide shadow-xs ${initialProduct.badgeColor}`}
        >
          {initialProduct.badge}
        </span>
        <span
          id="carousel-discount"
          class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-bold bg-[#0F172A] text-white tracking-wider border border-[#B8860B]/40 shadow-xs"
        >
          {initialProduct.discount}
        </span>
      </div>

      <!-- Main Full-Bleed Image Display -->
      <img
        id="main-carousel-img"
        src={initialProduct.image}
        alt={initialProduct.alt}
        class="w-full h-full object-cover object-center transition-opacity duration-300"
      />

      <!-- Navigation Overlay Arrows -->
      <button
        id="carousel-prev"
        type="button"
        class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-white/90 hover:bg-white text-[#0F172A] shadow-md flex items-center justify-center border border-[#E5E7EB] transition-all hover:scale-105 active:scale-95 z-20 cursor-pointer"
        aria-label="Foto anterior"
      >
        <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="carousel-next"
        type="button"
        class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-white/90 hover:bg-white text-[#0F172A] shadow-md flex items-center justify-center border border-[#E5E7EB] transition-all hover:scale-105 active:scale-95 z-20 cursor-pointer"
        aria-label="Foto siguiente"
      >
        <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Bottom Caption Bar on Carousel -->
      <div class="absolute bottom-2.5 sm:bottom-4 left-3 sm:left-8 right-3 sm:right-8 z-20 flex items-center justify-between gap-2 pointer-events-none">
        <span id="carousel-caption" class="bg-white/95 backdrop-blur-xs py-1 px-2.5 sm:py-1.5 sm:px-3.5 rounded-lg text-[10px] sm:text-xs font-medium text-[#0F172A] border border-[#E5E7EB] shadow-xs truncate max-w-[200px] sm:max-w-md">
          {initialProduct.name}
        </span>
        <span id="carousel-counter" class="bg-[#0F172A]/80 text-white font-mono text-[10px] sm:text-xs py-1 px-2.5 sm:py-1.5 sm:px-3 rounded-lg shrink-0">
          1 / {products.length}
        </span>
      </div>

    </div>

    <!-- Thumbnails Strip Under Carousel: 4 Variants -->
    <div class="max-w-4xl mx-auto px-2.5 sm:px-4 py-2.5 sm:py-4">
      <div class="grid grid-cols-4 gap-1.5 sm:gap-3">
        {products.map((p, idx) => (
          <button
            type="button"
            data-index={idx}
            class={`carousel-thumb relative rounded-lg sm:rounded-xl overflow-hidden border-2 aspect-[16/10] sm:aspect-[16/9] transition-all cursor-pointer group ${
              idx === 0
                ? 'border-[#B8860B] ring-2 ring-[#B8860B]/20 shadow-xs opacity-100'
                : 'border-[#E5E7EB] opacity-65 hover:opacity-100'
            }`}
          >
            <img src={p.image} alt={p.name} class="w-full h-full object-cover" />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-1 sm:p-1.5 flex flex-col justify-end text-left">
              <span class="text-[9px] sm:text-[11px] font-bold text-white truncate leading-tight">{p.shortName}</span>
              <span class="text-[8px] sm:text-[10px] text-[#F8E7B9] font-semibold">{p.price}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- 2. Información Dinámica del Producto & Compra Proporcional -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Value Details -->
      <div class="lg:col-span-7">
        
        <div class="flex items-center gap-2 mb-2.5">
          <div class="flex items-center text-[#B8860B] text-sm">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <span class="text-xs font-bold text-[#0F172A]">4.9 de 5</span>
          <span class="text-xs text-[#64748B]">•</span>
          <a href="#testimonios" class="text-xs font-semibold text-[#B8860B] hover:underline">
            +840 clientas satisfechas
          </a>
        </div>

        <h1 id="product-title" class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#0F172A] leading-tight mb-2">
          {initialProduct.name}
        </h1>

        <p id="product-subtitle" class="text-xs sm:text-sm font-semibold text-[#B8860B] tracking-wide uppercase mb-4">
          {initialProduct.tagline}
        </p>

        <p id="product-description" class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-6">
          {initialProduct.description}
        </p>

        <!-- Product Features List -->
        <div id="product-features" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-[#334155] mb-6">
          {initialProduct.features.map(f => (
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span>{f}</span>
            </div>
          ))}
        </div>

      </div>

      <!-- Right: Direct Purchase Card -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-[#FAFAFA] border border-[#E5E7EB] p-4.5 sm:p-7 shadow-xs">
          
          <div class="flex items-baseline justify-between mb-4 pb-4 border-b border-[#E5E7EB]">
            <div>
              <div class="flex items-baseline gap-2">
                <span id="product-price" class="font-serif text-2xl sm:text-4xl font-extrabold text-[#0F172A]">
                  {initialProduct.price}
                </span>
                <span id="product-regular-price" class="text-xs sm:text-sm line-through text-[#94A3B8] font-medium">
                  {initialProduct.regularPrice}
                </span>
              </div>
              <span id="product-savings" class="text-[11px] font-bold text-[#059669]">
                {initialProduct.savings}
              </span>
            </div>
            <span id="product-discount-badge" class="px-2.5 py-1 rounded-md text-xs font-bold bg-[#B8860B] text-white">
              {initialProduct.discount}
            </span>
          </div>

          <!-- Quick Actions hooked to CartModal -->
          <div class="space-y-3 mb-5">
            <button
              id="hero-buy-now-btn"
              type="button"
              class="w-full py-3.5 px-5 rounded-xl font-bold text-sm sm:text-base text-white bg-[#0F172A] hover:bg-[#1E293B] border border-[#B8860B] transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>COMPRAR AHORA — PAGO AL RECIBIR</span>
              <span class="text-[#C5A059]">→</span>
            </button>

            <button
              id="hero-add-cart-btn"
              type="button"
              class="w-full py-3 px-5 rounded-xl font-bold text-xs sm:text-sm text-[#0F172A] bg-white hover:bg-[#F8FAFC] border border-[#CBD5E1] transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4 text-[#B8860B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Agregar a la Bolsa</span>
            </button>
          </div>

          <!-- Trust points -->
          <div class="space-y-1.5 text-[11px] text-[#475569] pt-4 border-t border-[#E5E7EB]">
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span><strong>Pagas en efectivo o transferencia</strong> al recibir en mano.</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span>Envío gratis a todo el país en 24 a 48 horas.</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#059669] font-bold">✓</span>
              <span>Garantía de satisfacción y cambio por 30 días.</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ products }}>
  function setupProductCarousel() {
    const mainImg = document.getElementById('main-carousel-img');
    const caption = document.getElementById('carousel-caption');
    const counter = document.getElementById('carousel-counter');
    const badge = document.getElementById('carousel-badge');
    const discount = document.getElementById('carousel-discount');
    const thumbs = document.querySelectorAll('.carousel-thumb');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const stage = document.getElementById('carousel-stage');

    // Dynamic product info elements
    const titleEl = document.getElementById('product-title');
    const subtitleEl = document.getElementById('product-subtitle');
    const descEl = document.getElementById('product-description');
    const featuresEl = document.getElementById('product-features');
    const priceEl = document.getElementById('product-price');
    const regPriceEl = document.getElementById('product-regular-price');
    const savingsEl = document.getElementById('product-savings');
    const discountBadgeEl = document.getElementById('product-discount-badge');

    const buyNowBtn = document.getElementById('hero-buy-now-btn');
    const addCartBtn = document.getElementById('hero-add-cart-btn');

    if (!mainImg || thumbs.length === 0) return;

    let currentIndex = 0;
    let autoplayTimer = null;

    function updateCarousel(index) {
      currentIndex = (index + products.length) % products.length;
      const currentProduct = products[currentIndex];

      // Update Carousel Image & Tags
      mainImg.src = currentProduct.image;
      mainImg.alt = currentProduct.alt;

      if (caption) caption.textContent = currentProduct.name;
      if (counter) counter.textContent = `${currentIndex + 1} / ${products.length}`;
      if (badge) {
        badge.textContent = currentProduct.badge;
        badge.className = `px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-bold tracking-wide shadow-xs ${currentProduct.badgeColor}`;
      }
      if (discount) discount.textContent = currentProduct.discount;

      // Update Thumbnails active state
      thumbs.forEach((t, i) => {
        if (i === currentIndex) {
          t.classList.remove('border-[#E5E7EB]', 'opacity-65');
          t.classList.add('border-[#B8860B]', 'ring-2', 'ring-[#B8860B]/20', 'opacity-100');
        } else {
          t.classList.remove('border-[#B8860B]', 'ring-2', 'ring-[#B8860B]/20', 'opacity-100');
          t.classList.add('border-[#E5E7EB]', 'opacity-65');
        }
      });

      // Update Product Details Card below carousel
      if (titleEl) titleEl.textContent = currentProduct.name;
      if (subtitleEl) subtitleEl.textContent = currentProduct.tagline;
      if (descEl) descEl.textContent = currentProduct.description;

      if (featuresEl) {
        featuresEl.innerHTML = currentProduct.features.map(f => `
          <div class="flex items-center gap-2">
            <span class="text-[#059669] font-bold">✓</span>
            <span>${f}</span>
          </div>
        `).join('');
      }

      if (priceEl) priceEl.textContent = currentProduct.price;
      if (regPriceEl) regPriceEl.textContent = currentProduct.regularPrice;
      if (savingsEl) savingsEl.textContent = currentProduct.savings;
      if (discountBadgeEl) discountBadgeEl.textContent = currentProduct.discount;
    }

    // Autoplay every 2.5 seconds (2500ms)
    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 2500);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function restartAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    // Pause on hover or touch so user can inspect details comfortably
    stage?.addEventListener('mouseenter', stopAutoplay);
    stage?.addEventListener('mouseleave', startAutoplay);
    stage?.addEventListener('touchstart', stopAutoplay, { passive: true });
    stage?.addEventListener('touchend', () => {
      restartAutoplay();
    }, { passive: true });

    // Thumbnails click
    thumbs.forEach((t) => {
      t.addEventListener('click', () => {
        const idx = parseInt(t.getAttribute('data-index') || '0', 10);
        updateCarousel(idx);
        restartAutoplay();
      });
    });

    // Arrow buttons
    prevBtn?.addEventListener('click', () => {
      updateCarousel(currentIndex - 1);
      restartAutoplay();
    });
    nextBtn?.addEventListener('click', () => {
      updateCarousel(currentIndex + 1);
      restartAutoplay();
    });

    // Hook up Buy Now and Add to Cart to CartModal with current active variant
    function getActiveCartItem() {
      const p = products[currentIndex];
      return {
        id: p.id,
        name: p.name,
        price: p.numericPrice,
        qty: 1,
        image: p.image
      };
    }

    buyNowBtn?.addEventListener('click', () => {
      if (window.openCartWithItem) {
        window.openCartWithItem(getActiveCartItem());
      }
    });

    addCartBtn?.addEventListener('click', () => {
      if (window.openCartWithItem) {
        window.openCartWithItem(getActiveCartItem());
      }
    });

    // Expose method to select product from anywhere
    window.selectCarouselProduct = function(idx) {
      updateCarousel(idx);
      restartAutoplay();
      document.getElementById('producto')?.scrollIntoView({ behavior: 'smooth' });
    };

    // Start 2.5s autoplay on initial load
    startAutoplay();
  }

  setupProductCarousel();
  document.addEventListener('astro:page-load', setupProductCarousel);
</script>
