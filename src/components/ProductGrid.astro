---
// src/components/ProductGrid.astro
const products = [
  {
    id: "prod-1",
    name: "Maletín Rose Gold con Espejo LED",
    badge: "MÁS VENDIDO",
    badgeColor: "bg-[#B8860B] text-white",
    image: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=800&q=80",
    description: "Tono rosa pastel con herrajes dorados. Incluye espejo LED recargable de 3 tonos, cable USB-C y separadores acolchados.",
    price: "S/. 129.00",
    numericPrice: 129,
    regularPrice: "S/. 179.00",
    savings: "Ahorras S/. 50.00",
    features: ["Espejo con luz táctil inteligente", "Batería 2000 mAh recargable", "Cuero vegano resistente al agua"]
  },
  {
    id: "prod-2",
    name: "Maletín Black Diamond con Espejo LED",
    badge: "EDICIÓN ELEGANTE",
    badgeColor: "bg-[#0F172A] text-white border border-[#B8860B]",
    image: "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=800&q=80",
    description: "Acabado negro profundo con texturado anti-rayaduras y cierres dorados de alta resistencia. El favorito para viajes y estudio.",
    price: "S/. 129.00",
    numericPrice: 129,
    regularPrice: "S/. 179.00",
    savings: "Ahorras S/. 50.00",
    features: ["Look profesional sobrio y distinguido", "Compartimentos de tamaño personalizable", "Limpieza ultra rápida con paño húmedo"]
  },
  {
    id: "prod-3",
    name: "Kit Deluxe: Maletín + 12 Brochas Profesionales",
    badge: "MEJOR VALOR",
    badgeColor: "bg-[#059669] text-white",
    image: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=800&q=80",
    description: "El maletín completo más un juego exclusivo de 12 brochas de cerdas ultra suaves para base, ojos, rubor y contorno.",
    price: "S/. 159.00",
    numericPrice: 159,
    regularPrice: "S/. 229.00",
    savings: "Ahorras S/. 70.00",
    features: ["Incluye set de 12 brochas premium", "Estuche organizador con tapa protectora", "Regalo ideal listo para obsequiar"]
  },
  {
    id: "prod-4",
    name: "Pack Dúo: 2 Maletines Premium con Espejo LED",
    badge: "MÁXIMO AHORRO",
    badgeColor: "bg-[#B8860B] text-white",
    image: "https://images.unsplash.com/photo-1583241800698-e8ab01830a07?auto=format&fit=crop&w=800&q=80",
    description: "Llevate dos maletines completos (combiná colores a tu elección). El combo perfecto para compartir o hacer un regalo de lujo.",
    price: "S/. 219.00",
    numericPrice: 219,
    regularPrice: "S/. 358.00",
    savings: "Ahorras S/. 139.00",
    features: ["2 maletines con sus espejos LED y cables", "Elegís los colores que prefieras al confirmar", "Envío prioritario con seguimiento"]
  }
];
---

<section id="catalogo" class="py-16 sm:py-20 lg:py-24 border-b border-[#E5E7EB] bg-[#F9FAFB]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold text-[#B8860B] uppercase tracking-widest block mb-2">
        Catálogo de Variantes y Ofertas
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#0F172A] tracking-tight mb-3">
        Elegí tu modelo favorito
      </h2>
      <p class="text-sm sm:text-base text-[#64748B] leading-relaxed">
        Todos los paquetes incluyen envío gratis y pago contra entrega al momento de recibir en tu domicilio.
      </p>
    </div>

    <!-- 2 Rows x 2 Columns Grid requested by user -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-5xl mx-auto">
      {products.map((prod) => (
        <div class="rounded-2xl bg-white border border-[#E5E7EB] hover:border-[#B8860B]/60 transition-all p-5 sm:p-6 shadow-xs flex flex-col justify-between group">
          <div>
            <!-- Image & Badge Container -->
            <div class="relative rounded-xl overflow-hidden bg-[#F8FAFC] aspect-[16/10] mb-5 border border-[#E5E7EB]">
              <span class={`absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md text-[10px] sm:text-xs font-bold ${prod.badgeColor}`}>
                {prod.badge}
              </span>
              <img
                src={prod.image}
                alt={prod.name}
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
              />
            </div>

            <!-- Stars & Title -->
            <div class="flex items-center gap-1 text-[#B8860B] text-xs mb-1.5">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span class="text-xs text-[#64748B] ml-1 font-medium">5.0</span>
            </div>

            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#0F172A] mb-2 leading-snug">
              {prod.name}
            </h3>

            <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
              {prod.description}
            </p>

            <!-- Features -->
            <div class="space-y-1.5 mb-5 text-xs text-[#334155]">
              {prod.features.map((f) => (
                <div class="flex items-center gap-2">
                  <span class="text-[#B8860B] font-bold">✓</span>
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Price & Button -->
          <div class="pt-4 border-t border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
            <div class="flex items-baseline justify-between sm:block">
              <div class="flex items-baseline gap-2">
                <span class="font-serif text-2xl font-extrabold text-[#0F172A]">{prod.price}</span>
                <span class="text-xs line-through text-[#94A3B8] font-medium">{prod.regularPrice}</span>
              </div>
              <span class="text-[11px] font-bold text-[#059669] block">{prod.savings}</span>
            </div>

            <button
              type="button"
              data-add-cart={JSON.stringify({
                id: prod.id,
                name: prod.name,
                price: prod.numericPrice,
                qty: 1,
                image: prod.image
              })}
              class="w-full sm:w-auto px-5 py-3 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white bg-[#0F172A] hover:bg-[#1E293B] border border-[#B8860B]/50 transition-colors shadow-xs shrink-0 cursor-pointer text-center"
            >
              Pedir Este Modelo
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
