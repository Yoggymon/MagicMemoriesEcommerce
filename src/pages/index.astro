---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import ProductHero from '../components/ProductHero.astro';
import Features from '../components/Features.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import Footer from '../components/Footer.astro';
import CartModal from '../components/CartModal.astro';
---

<Layout title="Maletín con Maquillaje Premium & Luz LED | EXOTIX Luxe">
  <AnnouncementBar />
  <Navbar />
  <main>
    <ProductHero />
    <Features />
    <ProductGrid />
    <Testimonials />
  </main>
  <CartModal />
  <StickyBuyBar />
  <Footer />
</Layout>
